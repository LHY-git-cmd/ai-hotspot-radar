# GitHub Token 可选。留空即可使用公开 API；遇到配额限制时稍后重试。
# 如需填写，请使用有权读取公开仓库的 Token，不要提交真实密钥。
GITHUB_TOKEN=

# 相对路径以项目根目录为基准；SQLite 自动创建文件并保留历史记录。
AI_RADAR_DB_PATH=data/hotspots.sqlite3

# 第三期：也可直接使用系统环境变量；不要提交真实密钥。
DEEPSEEK_API_KEY=
# 模型只在配置层选择，能力目录目前已核对以下默认模型。
DEEPSEEK_MODEL=deepseek-flash
# strict 使用官方 beta 工具 Schema；json_object 为显式替代，不自动降级重试。
AI_OUTPUT_MODE=strict
AI_MAX_OUTPUT_TOKENS=6000
AI_MAX_ATTEMPTS=3
AI_MAX_CANDIDATES=10

# 首次建立预算设置时生效；以后使用网页保存的月上限，防止重启绕过预算。
AI_MONTHLY_BUDGET_CNY=100
# 官方人民币高峰价，用于保守估算；不是最终账单。
AI_PRICE_CURRENCY=CNY
AI_PRICE_VERSION=deepseek-2026-11-01-peak-conservative
# 默认价格随已核对模型目录选择，切换模型不会继承示例里的旧模型单价。
# 仅自定义价格时取消注释，并核对币种、全部单价及价格版本；不能填写空串。
# 每百万 Token：缓存命中/未命中/输出，以下是默认 Flash 高峰价示例。
# AI_INPUT_HIT_PRICE=0.04
# AI_INPUT_MISS_PRICE=2
# AI_OUTPUT_PRICE=8
# 人民币为1；如切换外币，必须同时配置该币种全部单价及实际换算系数。
AI_CNY_PER_CURRENCY_UNIT=1
